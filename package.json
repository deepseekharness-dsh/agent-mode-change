{
  "name": "agent-mode-change",
  "version": "1.0.1",
  "type": "module",
  "description": "Agent-mode floating window for DeepSeek Harness (dsh): switch a session's system prompt between the harness's own prompt and 13 archived coding-agent CLI prompts (Claude Code, Codex CLI, Antigravity, Grok, Kimi, MiniMax, opencode, Pi…) from a draggable Web-UI panel. Cordis bundle, log-safe via the official /agent command.",
  "license": "MIT",
  "author": "deepseekharness",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseekharness-dsh/agent-mode-change.git"
  },
  "homepage": "https://github.com/deepseekharness-dsh/agent-mode-change#readme",
  "bugs": {
    "url": "https://github.com/deepseekharness-dsh/agent-mode-change/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "agent-mode",
    "agent-emulation",
    "ai-agent",
    "coding-agent",
    "cli-agent",
    "system-prompt",
    "prompt-engineering",
    "claude-code",
    "codex",
    "floating-window",
    "web-ui",
    "plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
